{
    "version": 2,
    "builds": [
      { "src": "main.py", "use": "@vercel/python" }
    ],
    "functions": {
      "main.py": {
        "excludeFiles": [
          "gan_runner/**",
          "models/**",
          "__pycache__/**",
          "*.so",
          "torch/**"
        ]
      }
    },
    "routes": [
      { "src": "/(.*)", "dest": "main.py" }
    ]
  }